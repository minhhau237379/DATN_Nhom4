<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đơn hàng của tôi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/layout.css">
    <style>
        /* ===== RESET ===== */
        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f5f6fa;
            margin: 0;
            color: #222;
        }

        /* ===== CONTAINER ===== */
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        .orders-page h1 {
            font-size: 24px;
            margin-bottom: 20px;
        }

        /* ===== ORDER CARD ===== */
        .order-card {
            background: #fff;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            transition: all 0.2s ease;
        }

        .order-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 22px rgba(0, 0, 0, 0.08);
        }

        /* ===== HEADER ===== */
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }

        .order-date {
            font-size: 13px;
            color: #888;
            margin-top: 4px;
        }

        /* ===== STATUS BADGE ===== */
        .order-status {
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        /* trạng thái */
        .order-status.pending {
            background: #fff3cd;
            color: #856404;
        }

        .order-status.processing {
            background: #d1ecf1;
            color: #0c5460;
        }

        .order-status.shipped {
            background: #cce5ff;
            color: #004085;
        }

        .order-status.delivered {
            background: #d4edda;
            color: #155724;
        }

        .order-status.cancelled {
            background: #f8d7da;
            color: #721c24;
        }

        /* ===== ITEMS ===== */
        .order-items {
            border-top: 1px solid #f0f0f0;
            border-bottom: 1px solid #f0f0f0;
            padding: 12px 0;
        }

        .order-item {
            display: flex;
            gap: 12px;
            margin-bottom: 12px;
        }

        .order-item:last-child {
            margin-bottom: 0;
        }

        .order-item img {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: 10px;
            background: #f2f2f2;
        }

        .item-info h4 {
            margin: 0 0 4px;
            font-size: 15px;
        }

        .item-info p {
            margin: 0;
            font-size: 13px;
            color: #666;
        }

        .more-items {
            font-size: 13px;
            color: #888;
            margin-top: 6px;
        }

        /* ===== FOOTER ===== */
        .order-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
        }

        .order-total {
            font-size: 15px;
        }

        .order-total strong {
            color: #e53935;
            font-size: 16px;
        }

        /* ===== BUTTONS ===== */
        .btn {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 13px;
            cursor: pointer;
            border: none;
            text-decoration: none;
            display: inline-block;
            transition: all 0.15s ease;
        }

        .btn-outline {
            border: 1px solid #ddd;
            color: #333;
            background: #fff;
            margin-bottom: 10px;
        }

        .btn-outline:hover {
            background: #f5f5f5;
        }

        .btn-danger {
            background: #e53935;
            color: #fff;
        }

        .btn-danger:hover {
            background: #c62828;
        }

        /* ===== EMPTY ===== */
        .empty-orders {
            text-align: center;
            padding: 60px 20px;
            background: #fff;
            border-radius: 16px;
        }

        .btn-primary {
            background: #1976d2;
            color: #fff;
            margin-top: 10px;
        }

        .btn-primary:hover {
            background: #125ea8;
        }
    </style>

</head>

<body>


    <main class="container orders-page">
        <h1>Đơn hàng của tôi</h1>

        <div class="orders-list">
            <% if (orders && orders.length> 0) { %>
                <% orders.forEach(order=> { %>
                    <div class="order-card">
                        <div class="order-header">
                            <div>
                                <h3>Mã đơn: #<%= order._id.toString().slice(-6) %>
                                </h3>
                                <p class="order-date">
                                    Đặt ngày: <%= new Date(order.createdAt).toLocaleDateString('vi-VN') %>
                                </p>
                            </div>
                            <% const statusMap={ 'pending' : 'Chờ xử lý' , 'processing' : 'Đang xử lý' , 'shipped'
                                : 'Đang giao hàng' , 'delivered' : 'Đã giao' , 'cancelled' : 'Đã hủy' }; %>

                                <div class="order-status <%= order.orderStatus %>">
                                    <%= statusMap[order.orderStatus] || order.orderStatus %>
                                </div>
                        </div>

                        <div class="order-items">
                            <% order.items.slice(0, 2).forEach(item=> { %>
                                <div class="order-item">
                                    <img src="<%= item.image || '/images/no-image.png' %>"
                                        alt="<%= item.name || 'Sản phẩm' %>">

                                    <div class="item-info">
                                        <h4>
                                            <%= item.name || 'Sản phẩm đã xóa' %>
                                        </h4>
                                        <p>Số lượng: <%= item.quantity %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>

                                    <% if (order.items.length> 2) { %>
                                        <p class="more-items">+<%= order.items.length - 2 %> sản phẩm khác</p>
                                        <% } %>
                        </div>

                        <div class="order-footer">
                            <div class="order-total">
                                Tổng cộng: <strong>
                                    <%= order.totalPrice.toLocaleString() %>
                                </strong>
                            </div>
                            <div class="order-actions">
                                <a href="/orders/<%= order._id %>" class="btn btn-outline">Xem chi tiết</a>

                                <% if (order.orderStatus==='pending' ) { %>
                                    <button class="btn btn-danger" onclick="cancelOrder('<%= order._id %>')">
                                        Hủy đơn
                                    </button>
                                    <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="empty-orders">
                                <p>Bạn chưa có đơn hàng nào</p>
                                <a href="/shop" class="btn btn-primary">Mua sắm ngay</a>
                            </div>
                            <% } %>
        </div>
    </main>



    <script>
        function getStatusText(status) {
            const statusMap = {
                'pending': 'Chờ xử lý',
                'processing': 'Đang xử lý',
                'shipped': 'Đang giao hàng',
                'delivered': 'Đã giao',
                'cancelled': 'Đã hủy'
            };
            return statusMap[status] || status;
        }

        async function cancelOrder(orderId) {
            if (!confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) return;

            const reason = prompt('Lý do hủy đơn hàng:');
            if (!reason) return;

            try {
                const response = await fetch(`/orders/${orderId}/cancel`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ reason })
                });

                const result = await response.json();

                if (result.success) {
                    alert('Đã hủy đơn hàng thành công');
                    location.reload();
                } else {
                    alert('Lỗi: ' + result.message);
                }
            } catch (error) {
                console.error('Lỗi:', error);
                alert('Có lỗi xảy ra khi hủy đơn hàng');
            }
        }
    </script>
    <%- include('partials/bottom-nav', { active: 'cart' }) %>
</body>

</html>