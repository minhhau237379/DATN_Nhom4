<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Tài khoản</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/layout.css">

    <style>
        body {
            background: #f6f6f6;
            padding-bottom: 70px;
        }

        .avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: #ffecb3;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin: auto;
            margin-bottom: 20px;
        }

        .card-box {
            background: #fff;
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 16px;
        }

        .quick-item {
            text-align: center;
            font-size: 13px;
        }

        .quick-item span {
            font-size: 24px;
            display: block;
            margin-bottom: 4px;
        }

        .list-group-item {
            border: none;
            border-bottom: 1px solid #eee;
        }

        .list-group-item:last-child {
            border-bottom: none;
        }

        .logout {
            color: #f44336;
            font-weight: 600;
        }

        .logout-modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .logout-box {
            background: #fff;
            width: 85%;
            max-width: 320px;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
        }

        .logout-box p {
            font-size: 15px;
            margin-bottom: 20px;
        }

        .logout-actions {
            display: flex;
            gap: 10px;
        }

        .btn-cancel {
            flex: 1;
            border: none;
            padding: 10px;
            border-radius: 8px;
            background: #eee;
        }

        .btn-confirm {
            flex: 1;
            border: none;
            padding: 10px;
            border-radius: 8px;
            background: #f44336;
            color: #fff;
        }
    </style>
</head>

<body>

    <div class="container mt-4">

        <!-- PROFILE HEADER -->
        <div class="text-center">
            <div class="avatar">🧸</div>
            <h6 class="mt-4">
                <%= user?.username || 'Người dùng' %>
            </h6>
            <!-- <a href="/profile/edit" class="btn btn-outline-warning btn-sm">
                Chỉnh sửa hồ sơ
            </a> -->
        </div>

        <!-- QUICK ACTION (chỉ để account-related) -->
        <!-- <div class="card-box mt-4">
            <div class="row">
                <div class="col quick-item">
                    <span>📦</span>
                    <a href="/orders" class="text-decoration-none text-dark">
                        Đơn hàng
                    </a>
                </div>
                <div class="col quick-item">
                    <span>💳</span>
                    <a href="/payments" class="text-decoration-none text-dark">
                        Thanh toán
                    </a>
                </div>
                <div class="col quick-item">
                    <span>⚙️</span>
                    <a href="/settings" class="text-decoration-none text-dark">
                        Cài đặt
                    </a>
                </div>
            </div>
        </div> -->

        <!-- ACCOUNT SETTINGS -->
        <div class="card-box">
            <div class="list-group list-group-flush">
                <a href="/profile/info" class="list-group-item d-flex justify-content-between">
                    Thông tin cá nhân <span>›</span>
                </a>
                <a href="/change-password" class="list-group-item d-flex justify-content-between">
                    Đổi mật khẩu <span>›</span>
                </a>
                <a href="#" class="list-group-item d-flex justify-content-between logout"
                    onclick="openLogoutModal(event)">
                    Đăng xuất <span>›</span>
                </a>


            </div>
        </div>

        <!-- ORDER & PAYMENT -->
        <div class="card-box">
            <div class="list-group list-group-flush">
                <a href="/orders" class="list-group-item d-flex justify-content-between">
                    Đơn hàng của tôi <span>›</span>
                </a>
                <a href="/payments" class="list-group-item d-flex justify-content-between">
                    Lịch sử thanh toán <span>›</span>
                </a>
            </div>
        </div>

    </div>
    <!-- LOGOUT CONFIRM MODAL -->
    <div id="logoutModal" class="logout-modal">
        <div class="logout-box">
            <p>Bạn có chắc muốn đăng xuất không?</p>
            <div class="logout-actions">
                <button class="btn-cancel" onclick="closeLogoutModal()">Hủy</button>
                <button class="btn-confirm" onclick="logout()">Đăng xuất</button>
            </div>
        </div>
    </div>

    <script>
        async function logout(e) {
            e.preventDefault();

            await fetch("/api/auth/logout", {
                method: "POST",
                credentials: "same-origin"
            });

            window.location.href = "/login";
        }
    </script>
    <script>
        function openLogoutModal(e) {
            e.preventDefault();
            document.getElementById("logoutModal").style.display = "flex";
        }

        function closeLogoutModal() {
            document.getElementById("logoutModal").style.display = "none";
        }

        async function logout() {
            try {
                const res = await fetch("/api/auth/logout", {
                    method: "POST",
                    credentials: "same-origin"
                });

                const data = await res.json();
                if (data.success) {
                    window.location.href = "/login";
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>

    <!-- BOTTOM NAV -->
    <%- include('partials/bottom-nav', { active: 'profile' }) %>

</body>

</html>