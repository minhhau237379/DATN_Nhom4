<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Thông tin cá nhân</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/layout.css">

  <style>
    body {
      background: #f6f6f6;
      padding-bottom: 80px;
    }

    .info-card {
      background: #fff;
      border-radius: 16px;
      padding: 16px;
      margin-top: 16px;
    }

    .avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: #ffe0b2;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      margin: auto;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
      font-size: 14px;
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .label {
      color: #888;
    }

    .value {
      font-weight: 500;
    }

    .edit-btn {
      width: 100%;
      background: #ff9800;
      color: #fff;
      border: none;
      padding: 12px;
      border-radius: 30px;
      margin-top: 20px;
      font-weight: 600;
    }
  </style>
</head>

<body>

<div class="container">

  <!-- AVATAR -->
  <div class="info-card text-center">
    <div class="avatar">🧸</div>
    <h6 class="mt-2 mb-0"><%= user.username %></h6>
    <small class="text-muted"><%= user.email %></small>
  </div>

  <!-- INFO -->
  <div class="info-card">
    <div class="info-row">
      <div class="label">Tên đăng nhập</div>
      <div class="value"><%= user.username %></div>
    </div>

    <div class="info-row">
      <div class="label">Email</div>
      <div class="value"><%= user.email %></div>
    </div>

    <div class="info-row">
      <div class="label">Số điện thoại</div>
      <div class="value">
        <%= user.phoneNumber || "Chưa cập nhật" %>
      </div>
    </div>
  </div>

  <!-- EDIT -->
    <a href="/profile/edit" class="btn btn-warning w-100 mt-3">
    ✏️ Chỉnh sửa thông tin
  </a>

</div>

<!-- BOTTOM NAV -->
<%- include('partials/bottom-nav', { active: 'profile' }) %>

</body>
</html>
