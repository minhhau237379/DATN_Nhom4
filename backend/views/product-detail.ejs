<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Chi tiết sản phẩm</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/layout.css">
    <style>
        body {
            background: #f5f5f5;
            margin: 0;
            font-family: sans-serif;
            padding-bottom: 80px;
        }

        .container {
            padding: 15px;
        }

        .product-image {
            width: 100%;
            border-radius: 15px;
            background: white;
            padding: 10px;
        }

        .price {
            color: red;
            font-weight: bold;
            font-size: 20px;
        }

        .btn-cart {
            background: #d5001c;
            color: white;
            border-radius: 30px;
            padding: 14px 18px;
            width: 100%;
            border: none;

            min-height: 52px;
            font-size: 16px;
            font-weight: 600;

            display: flex;
            align-items: center;
            justify-content: center;

            cursor: pointer;
            position: relative;
            z-index: 10;
        }

        .btn-cart:active {
            transform: scale(0.97);
            opacity: 0.9;
        }


        .section {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin-top: 15px;
        }

        .related-products {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .related-card {
            background: white;
            border-radius: 12px;
            padding: 10px;
            text-align: center;
        }

        .related-card img {
            width: 100%;
            height: 100px;
            object-fit: contain;
        }

        .heart {
            cursor: pointer;
            font-size: 45px;
            color: gray;
            padding-left: 20px;
        }

        .heart.active {
            color: red;
        }

        .page-wrapper {
            padding: 15px;
        }

        .toast-box {
            position: fixed;
            bottom: 70px;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: white;
            padding: 10px 18px;
            border-radius: 20px;
            font-size: 14px;
            opacity: 0;
            transition: 0.3s;
            z-index: 9999;
        }

        .toast-box.show {
            opacity: 1;
            bottom: 90px;
        }
    </style>
</head>

<body>

    <div class="page-wrapper">

        <!-- IMAGE -->
        <div class="product-image text-center">
            <img src="<%= product.image %>" width="100%">
        </div>

        <!-- NAME + PRICE -->
        <div class="section">
            <h5>
                <%= product.name %>
            </h5>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="price">
                    <%= product.price.toLocaleString("vi-VN") %>₫
                </div>

                <span class="heart <%= favorites.includes(product._id.toString()) ? 'active' : '' %>"
                    onclick="toggleFav('<%= product._id %>', this, event)">
                    ❤
                </span>
            </div>


        </div>

        <!-- ADD TO CART -->
        <button class="btn-cart mt-3" onclick="addToCart('<%= product._id %>')">
            Thêm Vào Giỏ Hàng
        </button>

        <!-- DESCRIPTION -->
        <div class="section">
            <h6>Mô tả sản phẩm</h6>
            <p>
                <%= product.description %>
            </p>
            <% if (product.specifications) { %>
                <table class="table">
                    <% for (let key in product.specifications) { %>
                        <tr>
                            <td>
                                <%= key %>
                            </td>
                            <td>
                                <%= product.specifications[key] %>
                            </td>
                        </tr>
                        <% } %>
                </table>
                <% } else { %>
                    <p>Chưa có thông tin chi tiết</p>
                    <% } %>

        </div>

        <!-- RELATED PRODUCTS -->
        <% if (relatedProducts && relatedProducts.length> 0) { %>
            <div class="section">
                <h6>Sản Phẩm Liên Quan</h6>
                <div class="related-products">
                    <% relatedProducts.forEach(p=> { %>
                        <a href="/product/<%= p._id %>" style="text-decoration:none;color:black">
                            <div class="related-card">
                                <img src="<%= p.image %>">
                                <div>
                                    <%= p.name %>
                                </div>
                                <div class="price">
                                    <%= p.price.toLocaleString("vi-VN") %>₫
                                </div>
                            </div>
                        </a>
                        <% }) %>
                </div>
            </div>
            <% } %>

    </div>

    <script>
        async function toggleFav(id, el, event) {
            event.preventDefault();
            event.stopPropagation();

            try {
                const res = await fetch(`/favorite/toggle/${id}`, {
                    method: "POST",
                    credentials: "same-origin"
                });

                const data = await res.json();

                if (data.success) {
                    el.classList.toggle("active");
                    showToast("❤️ Đã cập nhật sản phẩm yêu thích");
                } else {
                    showToast("⚠️ Bạn cần đăng nhập");
                }

            } catch (err) {
                console.error(err);
                showToast("❌ Lỗi hệ thống");
            }
        }
    </script>
    <script>
        async function addToCart(productId) {
            try {
                const res = await fetch("/cart/add", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({ productId })
                });

                const data = await res.json();

                if (data.success) {
                    showToast("🛒 Đã thêm vào giỏ hàng");
                } else {
                    showToast("⚠️ Bạn cần đăng nhập");
                }

            } catch (err) {
                console.error(err);
                showToast("❌ Lỗi hệ thống");
            }
        }


    </script>
    <script>
        function showToast(message) {
            const toast = document.getElementById("toast");
            toast.innerText = message;
            toast.classList.add("show");

            setTimeout(() => {
                toast.classList.remove("show");
            }, 2000);
        }
    </script>

    <div id="toast" class="toast-box">
        ✔ Đã thêm vào giỏ hàng
    </div>


    <!-- Bottom Navigation -->
    <%- include('partials/bottom-nav', { active: 'shop' }) %>
</body>



</html>