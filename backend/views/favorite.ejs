<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Sản phẩm yêu thích</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/layout.css">

  <style>
    body {
      background: #f5f5f5;
      padding-bottom: 80px;
      font-family: sans-serif;
    }

    .header {
      background: white;
      padding: 12px;
      font-weight: bold;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      padding: 12px;
    }

    .product-card {
      background: white;
      border-radius: 14px;
      padding: 10px;
      text-align: center;
      position: relative;
      transition: 0.2s;
    }

    .product-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .product-card img {
      width: 100%;
      height: 120px;
      object-fit: contain;
    }

    .price {
      color: red;
      font-weight: bold;
    }

    .heart {
      position: absolute;
      top: 8px;
      right: 8px;
      cursor: pointer;
      font-size: 20px;
      color: red;
      background: #fff;
      border-radius: 50%;
      padding: 4px 8px;
      transition: 0.2s;
    }

    .heart:hover {
      transform: scale(1.2);
    }

    .empty-box {
      text-align: center;
      margin-top: 50px;
      color: gray;
    }

    .empty-box span {
      font-size: 40px;
      display: block;
      margin-bottom: 10px;
    }
  </style>
</head>

<body>

<div class="header">
  ❤️ Sản phẩm yêu thích
</div>

<% if (products && products.length > 0) { %>
<div class="product-grid">
  <% products.forEach(p => { %>
    <div class="product-card">
      
      <span class="heart" onclick="toggleFav('<%= p._id %>', this)">
        ❤
      </span>

      <a href="/product/<%= p._id %>" style="text-decoration:none;color:black">
        <img src="<%= p.image %>">
        <div><%= p.name %></div>
        <div class="price">
          <%= p.price.toLocaleString("vi-VN") %>₫
        </div>
      </a>

    </div>
  <% }) %>
</div>
<% } else { %>
<div class="empty-box">
  <span>💔</span>
  Chưa có sản phẩm yêu thích
</div>
<% } %>

<!-- Bottom Nav -->
<%- include('partials/bottom-nav', { active: 'favorite' }) %>

<script>
async function toggleFav(id, el) {
  try {
    const res = await fetch(`/favorite/toggle/${id}`, {
      method: "POST",
      credentials: "same-origin"
    });

    const data = await res.json();

    if (data.success) {
      el.closest(".product-card").remove();
    }
  } catch (err) {
    console.error(err);
  }
}
</script>

</body>
</html>

