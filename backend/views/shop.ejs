<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Shop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/layout.css">
    <style>
        body {
            background: #f5f5f5;
            margin: 0;
            font-family: sans-serif;
        }

        /* HEADER */
        .top-header {
            background: #d5001c;
            padding: 10px;
            color: white;
        }

        .search-box {
            background: white;
            border-radius: 25px;
            padding: 6px 12px;
            display: flex;
            align-items: center;
        }

        .search-box input {
            border: none;
            outline: none;
            width: 100%;
        }

        /* Filter bar */
        .filter-bar {
            display: flex;
            justify-content: space-between;
            padding: 10px 15px;
            background: white;
            border-bottom: 1px solid #eee;
        }

        button,
        select,
        input {
            border-radius: 20px !important;
        }

        .product-card {
            border-radius: 16px;
            padding: 12px;
            background: white;
            transition: 0.2s;
            cursor: pointer;
        }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }


        /* Product Grid */
        .product-grid {
            display: grid !important;
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 12px;
            padding: 10px;

        }



        .product-card {
            background: white;
            border-radius: 12px;
            padding: 10px;
            text-align: center;
            width: 100%;
        }


        .product-card img {
            width: 100%;
            height: 120px;
            object-fit: contain;
        }

        .bottom-nav img {
            width: 24px;
            height: 24px;
            object-fit: contain;
        }

        .product-info {
            padding: 8px 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;

        }

        .product-title {
            font-size: 14px;
            font-weight: 500;
            line-height: 1.4;

            display: -webkit-box;
            -webkit-line-clamp: 2;

            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 40px;
            /* 👈 chìa khóa card đều */
        }

        .product-link {
            text-decoration: none !important;
            color: inherit !important;
        }

        .product-link:hover {
            text-decoration: none !important;
            color: inherit !important;
        }




        .price {
            color: red;
            font-weight: bold;

        }

        .price-row {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 4px;

        }

        .heart {
            cursor: pointer;
            color: gray;
            font-size: 20px;
            margin-left: 10px;
        }

        .heart.active {
            color: red;
        }



        /* Sidebar filter */
        .filter-sidebar {
            position: fixed;
            top: 0;
            left: -300px;
            width: 260px;
            height: 100%;
            background: white;
            z-index: 2000;
            transition: 0.3s;
            overflow-y: auto;
            padding: 15px;
        }

        .filter-sidebar.active {
            left: 0;
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.3);
            display: none;
        }

        .overlay.active {
            display: block;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="top-header">
        <form method="GET" action="/shop">
            <div class="search-box">
                <input type="text" name="search" placeholder="Nhập từ khóa tìm kiếm...">
            </div>
        </form>
    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar">
        <div onclick="openFilter()">⚙ Bộ lọc</div>
        <div>
            <form method="GET" action="/shop">
                <h9>Sắp xếp theo: </h9>
                <select name="sort" onchange="this.form.submit()">
                    <option value="" <%=!query.sort ? "selected" : "" %>>Mặc định</option>
                    <option value="price_asc" <%=query.sort==="price_asc" ? "selected" : "" %>>
                        Giá tăng dần
                    </option>
                    <option value="price_desc" <%=query.sort==="price_desc" ? "selected" : "" %>>
                        Giá giảm dần
                    </option>
                </select>

            </form>
        </div>
    </div>

    <!-- PRODUCT GRID -->
    <div class="product-grid">
        <% products.forEach(p=> { %>
            <div class="product-card">
                <a href="/product/<%= p._id %>" class="product-link">

                    <img src="<%= p.image %>" class="product-img">

                    <div class="product-info">
                        <div class="product-title">
                            <%= p.name %>
                        </div>

                        <div class="price-row">
                            <span class="price">
                                <%= p.price.toLocaleString("vi-VN") %>₫
                            </span>

                            <span class="heart <%= favorites.includes(p._id.toString()) ? 'active' : '' %>"
                                data-id="<%= p._id %>" onclick="toggleFav('<%= p._id %>', this, event)">
                                ❤
                            </span>
                        </div>
                    </div>

                </a>
            </div>
            <% }) %>
    </div>


    <!-- SIDEBAR FILTER -->
    <div class="filter-sidebar" id="sidebar">
        <h5>Bộ lọc</h5>
        <button onclick="closeFilter()">Đóng</button>

        <form method="GET" action="/shop">

            <h6>Danh mục</h6>
            <% categories.forEach(cat=> { %>
                <label>
                    <input type="radio" name="category" value="<%= cat.name %>">
                    <%= cat.name %>
                </label><br>
                <% }) %>

                    <h6>Khoảng giá</h6>
                    <input type="number" name="minPrice" placeholder="Min" class="form-control mb-2">
                    <input type="number" name="maxPrice" placeholder="Max" class="form-control">

                    <button class="btn btn-dark mt-3 w-100">Lọc</button>
        </form>
    </div>

    <div class="overlay" id="overlay" onclick="closeFilter()"></div>

    <script>
        function openFilter() {
            document.getElementById("sidebar").classList.add("active");
            document.getElementById("overlay").classList.add("active");
        }
        function closeFilter() {
            document.getElementById("sidebar").classList.remove("active");
            document.getElementById("overlay").classList.remove("active");
        }
    </script>
    <!-- TOGGLE FAVORITE-->
     <script>
function showToast(message) {
    const toast = document.createElement("div");
    toast.innerText = message;

    toast.style.position = "fixed";
    toast.style.bottom = "80px";
    toast.style.left = "50%";
    toast.style.transform = "translateX(-50%)";
    toast.style.background = "rgba(0,0,0,0.8)";
    toast.style.color = "white";
    toast.style.padding = "10px 20px";
    toast.style.borderRadius = "20px";
    toast.style.zIndex = "9999";
    toast.style.fontSize = "14px";

    document.body.appendChild(toast);

    setTimeout(() => {
        toast.remove();
    }, 2000);
}
</script>

    <script>
        async function toggleFav(id, el, event) {
    event.preventDefault();
    event.stopPropagation();

    try {
        const res = await fetch(`/favorite/toggle/${id}`, {
            method: "POST",
            credentials: "same-origin"
        });

        // 🔥 Check status trước
        if (res.status === 401) {
            showToast("⚠️ Bạn cần đăng nhập");
            return;
        }

        const data = await res.json();

        if (data.success) {
            el.classList.toggle("active");
            showToast("❤️ Đã cập nhật sản phẩm yêu thích");
        }

    } catch (err) {
        console.error(err);
        showToast("❌ Lỗi hệ thống");
    }
}
    </script>
    <script>
        async function syncFavorites() {
            try {
                const res = await fetch("/favorite/list", {
                    credentials: "same-origin"
                });
                const data = await res.json();

                document.querySelectorAll(".heart").forEach(el => {
                    const id = el.dataset.id;
                    if (data.favorites.includes(id)) {
                        el.classList.add("active");
                    } else {
                        el.classList.remove("active");
                    }
                });
            } catch (err) {
                console.error(err);
            }
        }

        // chạy khi load bình thường
        document.addEventListener("DOMContentLoaded", syncFavorites);

        // chạy khi quay lại bằng back button
        window.addEventListener("pageshow", syncFavorites);
    </script>





    <!-- Bottom Navigation -->
    <%- include('partials/bottom-nav', { active: 'shop' }) %>
</body>

</html>