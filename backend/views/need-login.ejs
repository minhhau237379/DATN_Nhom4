<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Yêu cầu đăng nhập</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f5f5f5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: sans-serif;
        }

        .login-box {
            background: white;
            padding: 30px 25px;
            border-radius: 20px;
            text-align: center;
            width: 90%;
            max-width: 380px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            animation: fadeIn 0.3s ease;
        }

        .icon {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .message {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 25px;
            color: #333;
        }

        .btn-login {
            background: #d5001c;
            border: none;
            border-radius: 25px;
            padding: 10px;
            font-weight: 600;
        }

        .btn-login:hover {
            background: #b80017;
        }

        .btn-back {
            margin-top: 12px;
            border-radius: 25px;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>

    <div class="login-box">
        <div class="icon">🔒</div>

        <div class="message">
            <%= message || "Bạn cần đăng nhập để tiếp tục" %>
        </div>

        <a href="/login" class="btn btn-login w-100 text-white">
            Đăng nhập ngay
        </a>

        <a href="/shop" class="btn btn-outline-secondary btn-back w-100">
            Quay lại trang sản phẩm
        </a>
    </div>

</body>
</html>